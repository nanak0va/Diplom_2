{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "name", "order"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "object",
      "required": ["number"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}